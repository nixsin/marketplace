{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,js}",
        "scripts/**/*.test.mjs"
      ],
      "project": [
        "scripts/**/*.{mjs,js}"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "scripts/**/*.mjs",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,route,template,default,error,not-found,loading,sitemap,robots,opengraph-image,twitter-image,icon,apple-icon}.{ts,tsx}",
        "scripts/**/*.mjs",
        "e2e/**/*.ts",
        "test/**/*.ts",
        "src/components/ui/**/*.{ts,tsx}",
        "src/i18n/navigation.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/config": {
      "project": [
        "src/**/*.js"
      ]
    }
  },
  "ignoreExportsUsedInFile": false
}
