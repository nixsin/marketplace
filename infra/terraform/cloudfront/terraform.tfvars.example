aws_region = "ap-south-1"

web_origin_domain = "medinstru-web.onrender.com"
api_origin_domain = "medinstru-api.onrender.com"

# Certificates must exist in us-east-1 for CloudFront. Leave aliases empty
# for an initial test using the generated *.cloudfront.net hostnames.
web_aliases         = ["laxair.shop", "www.laxair.shop"]
web_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"

api_aliases         = ["api.laxair.shop"]
api_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/replace-me"
