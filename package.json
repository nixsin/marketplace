{
  "name": "medinstru-market",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm --filter web lint && pnpm --filter api lint:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@medinstru/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "openai": "^7.5.0"
  },
  "lint-staged": {
    "apps/api/**/*.ts": "pnpm --filter api exec eslint --fix",
    "apps/web/**/*.{ts,tsx}": "pnpm --filter web exec eslint --fix"
  }
}
