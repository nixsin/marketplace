# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which is documentation and carries NAMES ONLY, never
# values. `.env*` above is create-next-app's default and it silently swallowed
# this file: apps/web/.env.example has existed on disk for a while, is
# referenced by CLAUDE.md, and has never once been committed -- so a fresh
# clone gets no record of what apps/web actually needs. apps/api/.gitignore
# ignores only `.env` and has never had the problem.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
