# GraphQL API endpoint (apps/api)
NEXT_PUBLIC_API_URL="http://localhost:4000/graphql"

# This app's own public origin -- required for generateMetadata's
# OpenGraph images to resolve (Next.js errors at build time on a relative
# image URL with no metadataBase configured).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Signs and verifies source-map access tokens.
#
# NAME ONLY -- never commit a value. Source maps are moved out of the publicly
# served tree at build time and served by /sourcemaps/<file> only to a request
# whose mi_srcmap cookie carries a valid, unexpired, signed token. Leave this
# unset and the maps are simply unavailable, which is the safe default; the
# route fails closed.
#
# Generate the key once, set it on the web service, and export it locally:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Then mint a token whenever you need one -- it names you, is unique per
# grant, and expires (2h default, 24h ceiling):
#   pnpm --filter web sourcemap:token
SOURCEMAP_SIGNING_KEY=

# Which environment this is — see docs/environments.md. Detection reads
# NODE_ENV as production during `next build`/`next start`, which on a
# developer machine is ambiguous, so stating it removes a warning.
# One of: render, github-ci, ci-local, test, localhost, unknown.
APP_ENV="localhost"
