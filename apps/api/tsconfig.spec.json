{
  // Test-only compiler options.
  //
  // These tests run as ESM, which is what NestJS 12 requires: all
  // @nestjs/* packages now ship as ESM and declare `"type": "module"`, so
  // Jest cannot load them from a CommonJS test context at all --
  // `transformIgnorePatterns` does not help, because the refusal is based
  // on the package's own type declaration rather than on its syntax.
  //
  // This file used to do the exact opposite: it forced `module: commonjs`
  // so that @medinstru/config (plain ESM, no build step) would be emitted
  // as require() calls for a CommonJS Jest. That workaround is now
  // unnecessary and actively wrong -- running the suite as ESM is what
  // both dependencies wanted in the first place.
  //
  // So the only override left is `allowJs`, and the base config's
  // `nodenext` module/resolution pair -- which is what emits real ESM --
  // is inherited rather than overridden.
  // `module` must be forced. The base config's `nodenext` decides ESM vs
  // CJS from the nearest package.json's `type` field, and apps/api is not
  // `"type": "module"` -- so nodenext emits CommonJS here and the suite
  // fails with `ReferenceError: exports is not defined` even with ts-jest's
  // `useESM`. Making apps/api itself `"type": "module"` would fix it and
  // change what `nest build` emits for production at the same time; this
  // keeps the change inside the tests, which is the same reason the old
  // commonjs override lived here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  }
}
