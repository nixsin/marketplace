# Postgres connection (see docker-compose.yml / brew services for local values)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medinstru?schema=public"

# Redis (Phase 1: BullMQ queues, OTP store, caching — not wired yet)
REDIS_URL="redis://localhost:6379"

# Sign/verify JWTs issued by the auth module. Generate a real secret before
# anything beyond local dev: `openssl rand -base64 32`
JWT_SECRET="dev-secret-change-me"

PORT=4000

# Buyer product inquiries (#91). Both are NAMES ONLY here, as everywhere in
# this repo -- never a value; a committed secret is permanent in git history.

# Keys the HMAC that stores a submitter's IP as a hash rather than in the
# clear. Generate with `openssl rand -hex 24`; must be at least 16 characters.
#
# WITHOUT IT NOTHING BREAKS AND THE PER-IP RATE LIMIT SIMPLY DOES NOT RUN --
# no error, no failed request, one fewer abuse control on an unauthenticated
# endpoint. An unkeyed digest is not an alternative: IPv4's 2^32 space is
# small enough to enumerate, so anyone holding the table recovers the address.
INQUIRY_IP_HASH_SECRET=""

# Set to exactly "true" to derive the submitter's address from
# cf-connecting-ip / x-forwarded-for. Off by default and deliberately so:
# this origin also answers directly on its .onrender.com hostname, so a
# caller who skips the edge can forge a fresh value per request and walk past
# the per-IP limit. Enable only once the origin refuses traffic that did not
# arrive through the proxy.
INQUIRY_TRUST_PROXY_HEADERS="false"
