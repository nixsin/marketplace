# Postgres connection (see docker-compose.yml / brew services for local values)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medinstru?schema=public"

# Redis (Phase 1: BullMQ queues, OTP store, caching — not wired yet)
# Shared cache. LEFT UNSET on purpose: the API treats the cache as optional --
# no REDIS_URL yields a null cache and every read falls through to Postgres, so
# a bare checkout and CI both work without one. `./scripts/dev.sh` supplies a
# real value through docker-compose.
#
# Setting a value here would be worse than leaving it blank: CI copies this
# file verbatim (`cp .env.example .env`), so a URL pointing at a Redis that is
# not running makes every job construct a client, fail to connect, and log a
# cache-unavailable error for the whole run.
REDIS_URL=

# Sign/verify JWTs issued by the auth module. Generate a real secret before
# anything beyond local dev: `openssl rand -base64 32`
JWT_SECRET="dev-secret-change-me"

PORT=4000

# Buyer product inquiries (#91). Both are NAMES ONLY here, as everywhere in
# this repo -- never a value; a committed secret is permanent in git history.

# Keys the HMAC that stores a submitter's IP as a hash rather than in the
# clear. Generate with `openssl rand -hex 24`; must be at least 16 characters.
#
# WITHOUT IT NOTHING BREAKS AND THE PER-IP RATE LIMIT SIMPLY DOES NOT RUN --
# no error, no failed request, one fewer abuse control on an unauthenticated
# endpoint. An unkeyed digest is not an alternative: IPv4's 2^32 space is
# small enough to enumerate, so anyone holding the table recovers the address.
INQUIRY_IP_HASH_SECRET=""

# Set to exactly "true" to derive the submitter's address from
# cf-connecting-ip. That header ONLY -- x-forwarded-for is appended to by
# proxies rather than overwritten, so its left-most entry stays
# attacker-controlled; Cloudflare overwrites cf-connecting-ip, which is what
# makes it usable at all.
#
# Off by default and deliberately so: this origin also answers directly on
# its .onrender.com hostname, so a caller who skips the edge can set the
# header themselves. Enabling this asserts that the origin now REFUSES
# traffic which did not arrive through the proxy -- not merely that a proxy
# exists.
INQUIRY_TRUST_PROXY_HEADERS="false"

# WhatsApp delivery for buyer inquiries (#91). NAMES ONLY, as everywhere in
# this repo -- a committed credential is permanent in git history.
#
# With the token or phone id absent the service logs a warning naming only
# these variables and returns a failure; the inquiry is STILL RECORDED,
# because losing a real lead to a configuration gap is the worse outcome.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# The approved template. REQUIRED, not optional: business-initiated messages
# cannot be sent as free-form text -- WhatsApp only allows that inside a
# 24-hour window the recipient opens by messaging us first, which never
# happens here because the marketplace always speaks first. Unset means sends
# are refused before the request rather than attempted and rejected by Meta.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Opt-in for free-form text, for a KNOWN OPEN service window in development.
# Never a fallback for a missing template: that combination sends a request
# Meta is known to reject and marks every inquiry FAILED.
WHATSAPP_ALLOW_FREE_FORM="false"

# Which environment this is. Detection covers the common cases (see
# docs/environments.md); set this to state it outright and skip inference.
# One of: render, github-ci, ci-local, test, localhost, unknown.
APP_ENV="localhost"
