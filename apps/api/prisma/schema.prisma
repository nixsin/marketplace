// Prisma schema — Phase 0 entities (auth + org onboarding), plus a minimal
// Product slice added early to wire up one real catalog item end-to-end.
// Full Product/Category/RFQ/Lead/Order/Subscription model is Phase 1 (§6).

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  BUYER
  SELLER
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  STAFF
}

enum LicenseType {
  CDSCO_MANUFACTURING
  CDSCO_IMPORT
  GST
  UDYAM
}

enum DeviceClass {
  A
  B
  C
  D
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  gstin     String?   @unique
  type      OrgType
  kycStatus KycStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // E.164, e.g. +919876543210. The seller's VERIFIED BUSINESS number, never
  // a personal one (#91 story 6: staff must not be exposed to unsolicited
  // contact). Deliberately never exposed through GraphQL -- the send happens
  // server-side, so a scraper cannot harvest seller numbers from the API.
  // Product.canReceiveInquiries exposes only whether one is set.
  whatsappNumber String?

  users     User[]
  licenses  License[]
  products  Product[]
  inquiries Inquiry[]

  @@index([type, kycStatus])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  phone     String   @unique
  email     String?  @unique
  name      String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model License {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  type           LicenseType
  registrationNo String
  docUrl         String
  issuedAt       DateTime?
  expiresAt      DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime    @default(now())

  @@index([organizationId, type])
}

model Product {
  id       String       @id @default(cuid())
  sellerId String
  seller   Organization @relation(fields: [sellerId], references: [id])

  name           String
  brand          String
  category       String
  deviceClass    DeviceClass?
  certifications String[]
  location       String
  description    String       @default("")
  imageUrl       String?
  // Category-specific specs (blade size, power rating, etc.) that can't all
  // be anticipated up front across every product category -- see #92.
  // Nullable, no backfill needed. A JSONB column, not a separate document
  // database: schema-less per row within one column, while still living in
  // the same database/transaction/migration story as everything else.
  details        Json?
  createdAt      DateTime     @default(now())
  // Paired with an explicit default (not bare @updatedAt, unlike
  // Organization/User above) because Product already has real seeded rows
  // -- a bare @updatedAt with no default makes `prisma migrate dev` prompt
  // interactively for a backfill value. The default just means existing
  // rows' updatedAt becomes "the moment this column was added", an honest
  // synthetic value, not a real backfill.
  updatedAt      DateTime     @default(now()) @updatedAt

  inquiries Inquiry[]

  @@index([sellerId])
  // The catalogue's ONLY ordering, on both the cursor and the paged query:
  // `orderBy: [{ createdAt: 'desc' }, { id: 'desc' }]`. Without this the
  // listing -- the entry page of the whole application -- does a sequential
  // scan and a sort on every uncached request.
  //
  // Measured on 50,000 synthetic rows before adding it: Seq Scan reading all
  // 50,000 to return 7, cost 1770.84. After: Index Only Scan Backward
  // reading 7, cost 0.59.
  //
  // Declared ASC even though the query is DESC, because Postgres scans a
  // btree backwards for the reversed order -- verified, the plan really does
  // say "Index Only Scan Backward". A DESC-declared index would work too and
  // buy nothing.
  //
  // `id` is not decoration: it is the tiebreaker the query already sorts on,
  // and leaving it out would leave the sort node in place for ties.
  @@index([createdAt, id])
}

/// A buyer's inquiry about one product, delivered to the seller over
/// WhatsApp. Recorded in its own right rather than being a fire-and-forget
/// message: #91 story 9 wants the channel measurable (which product, which
/// seller, did it arrive) WITHOUT reading message content, and a lead that
/// only exists inside somebody's WhatsApp is a lead the marketplace cannot
/// see, attribute, or recover when delivery fails.
model Inquiry {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Denormalized from the product at inquiry time on purpose. Products can
  // be reassigned between organizations; the seller who received a given
  // inquiry is a historical fact and must not change retroactively.
  sellerId String
  seller   Organization @relation(fields: [sellerId], references: [id])

  buyerName  String
  buyerPhone String
  message    String

  /// KEYED HMAC of the caller's IP, or absent. Never the address itself, and
  /// never an unkeyed digest.
  ///
  /// The per-phone limits are keyed on values the caller types, so rotating
  /// E.164 numbers defeats them entirely. This adds a dimension the caller
  /// does not choose freely.
  ///
  /// A raw IP is personal data under DPDP sitting in a table operators read to
  /// triage leads. An UNKEYED SHA-256 is barely better: IPv4's 2^32 space is
  /// small enough to enumerate outright, so anyone holding the table recovers
  /// the address by hashing guesses. The key makes that impossible without
  /// also holding the secret, while keeping the value deterministic, which is
  /// all a rate limiter needs it for.
  ///
  /// Null when no usable secret is configured, or when no trustworthy
  /// per-client address is available -- the limiter skips a null bucket rather
  /// than collapsing every such caller into one shared one. Written by the
  /// submission flow; nothing in this change populates it.
  ipHash String?

  /// Stable per-SUBMISSION key, supplied by the client and unique.
  ///
  /// A lost response is indistinguishable from a failed one, so a retry would
  /// otherwise create a second inquiry AND send the seller a second WhatsApp
  /// message. The client generates this once per submission and reuses it on
  /// every retry, so the database rejects the duplicate rather than trusting
  /// the client to notice.
  ///
  /// Nullable because rows written before this existed have none, and in
  /// Postgres NULLs do not collide in a unique index -- so old rows coexist
  /// without a backfill inventing keys that never identified anything.
  idempotencyKey String? @unique

  status InquiryStatus @default(PENDING)

  /// Meta's message id, when the send succeeded. The only handle we have for
  /// correlating a delivery webhook back to this row later.
  providerMessageId String?

  /// Why a send failed, for operator diagnosis. Provider error text only --
  /// never the buyer's message body, which would duplicate content into logs.
  failureReason String?

  createdAt DateTime @default(now())

  // Seller inbox, newest first.
  @@index([sellerId, createdAt])
  // "has this buyer already asked about this product" and per-product counts.
  @@index([productId, createdAt])
  // Rate limiting reads by phone within a time window.
  @@index([buyerPhone, createdAt])
  // The caller-independent limit, and the absolute per-seller cap.
  @@index([ipHash, createdAt])
}

enum InquiryStatus {
  /// Recorded, not yet handed to the provider.
  PENDING
  /// Provider accepted it. Not the same as the seller having read it.
  SENT
  /// Provider rejected it, or no provider is configured. The lead is still
  /// recorded -- failing to deliver must never mean failing to capture.
  FAILED
}

/// A monotonic counter bumped whenever the catalogue changes.
///
/// This is the invalidation mechanism for the shared cache, and it exists
/// because delete-on-write cannot be made reliable across stateless
/// instances: if the process dies or the Redis call fails between the COMMIT
/// and the DEL, the stale entry survives its full TTL and nothing knows the
/// invalidation was lost.
///
/// Bumping this row INSIDE the writing transaction removes that window
/// entirely. Cache keys embed the version, so a reader on version 42 cannot
/// address an entry written under 41 -- invalidation stops being an action
/// that can fail and becomes a consequence of the write committing. A rolled
/// back transaction leaves the version untouched, which is also correct:
/// nothing changed, so nothing needed invalidating.
///
/// Single row, `id` fixed at 1. Not a table of versions per entity, because
/// the catalogue is the only cached aggregate today and a per-entity scheme
/// would be inventing structure for a need that does not exist yet.
model CacheVersion {
  id        Int      @id @default(1)
  /// Incremented, never reset. BigInt so it cannot realistically wrap.
  version   BigInt   @default(0)
  updatedAt DateTime @updatedAt
}
